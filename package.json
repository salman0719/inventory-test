{
  "name": "saas-shell-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "smoke": "tsx scripts/smoke.ts",
    "perf:budget": "tsx scripts/perf-budget.ts",
    "perf:nav": "tsx scripts/nav-timing-report.ts",
    "secrets:check": "node scripts/check-client-secrets.mjs",
    "db:up": "docker compose --env-file .env.local up -d db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:migrate:ci": "tsx db/migrate.ts --require-migrations",
    "db:migrate:hosted": "tsx db/migrate.ts --hosted",
    "db:app-role": "tsx db/app-role.ts",
    "db:app-role:local": "tsx db/app-role.ts --local",
    "db:link-user": "tsx db/link-user.ts",
    "db:sync-auth": "tsx db/sync-auth.ts",
    "db:seed": "tsx db/seed.ts",
    "db:seed:hosted": "tsx db/seed-hosted.ts",
    "db:seed:account": "tsx db/seed-account.ts",
    "new:ports": "tsx scripts/new-ports.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "papaparse": "^5.7.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zxing-wasm": "^3.1.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
