PORT=
APP_URL=
DATABASE_URL=
# Optional. 1 forces the development auth.uid() shim, 0 disables it.
# Unset means: apply only when DATABASE_URL points at localhost.
DB_AUTH_SHIM=
DB_HOST_PORT=
MAILPIT_SMTP_PORT=
MAILPIT_HTTP_PORT=
ADMINER_PORT=
SMOKE_SPARE_PORT=
EMAIL_FROM="starter <noreply@example.invalid>"
# Generated by `npm run new:ports` into `.env.local`. Never commit real secrets.
# Placeholders only here. `PORT` is the single source of truth for the app port.

# Hosted (Supabase). Leave blank for compose-only work; never commit values.
SUPABASE_DB_URL=
DATABASE_URL_APP=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
